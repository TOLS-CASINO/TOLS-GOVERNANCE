generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// MODULO FINANZIARIO (10 tabelle)
// ============================================

model CasinoDeposit {
  id            String   @id @default(cuid())
  playerId      String
  amount        Float
  currency      String   @default("USD")
  method        String   // crypto, card, bank_transfer
  txHash        String?  // blockchain hash for crypto
  status        String   @default("pending") // pending, confirmed, failed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  player        PlayerProfile @relation(fields: [playerId], references: [id])
}

model TotalWithdrawal {
  id            String   @id @default(cuid())
  playerId      String
  amount        Float
  currency      String   @default("USD")
  method        String
  status        String   @default("pending") // pending, approved, completed, rejected
  approvedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  player        PlayerProfile @relation(fields: [playerId], references: [id])
}

model HouseEarning {
  id            String   @id @default(cuid())
  gameId        String
  grossRevenue  Float
  playerPayout  Float
  houseEdge     Float    // percentage
  netEarning    Float
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime @default(now())
}

model CommissionLog {
  id            String   @id @default(cuid())
  affiliateId   String
  playerId      String
  amount        Float
  tier          String   // bronze, silver, gold, platinum
  rate          Float    // commission percentage
  createdAt     DateTime @default(now())
  affiliate     AffiliateProfile @relation(fields: [affiliateId], references: [id])
}

model GlobalJackpot {
  id            String   @id @default(cuid())
  name          String
  currentAmount Float
  seedAmount    Float
  contributionRate Float
  lastWonAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InternalLedger {
  id            String   @id @default(cuid())
  category      String   // operational, marketing, affiliate, jackpot, reserve
  description   String
  amount        Float
  type          String   // debit, credit
  periodWeek    String   // ISO week format
  reference     String?
  createdAt     DateTime @default(now())
}

model EscrowAccount {
  id            String   @id @default(cuid())
  totalBalance  Float
  pendingSettlement Float
  lastSettlement DateTime?
  settlementFrequency String @default("weekly")
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  settlements   SettlementLog[]
}

model SettlementLog {
  id            String   @id @default(cuid())
  escrowId      String
  amount        Float
  recipients    String   // JSON array of recipients
  status        String   @default("processing") // processing, completed, failed
  settledAt     DateTime @default(now())
  escrow        EscrowAccount @relation(fields: [escrowId], references: [id])
}

model BudgetTarget {
  id            String   @id @default(cuid())
  category      String
  targetAmount  Float
  actualAmount  Float
  variance      Float    // percentage
  periodWeek    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VarianceAlert {
  id            String   @id @default(cuid())
  category      String
  expectedValue Float
  actualValue   Float
  variancePercent Float
  threshold     Float    @default(15.0)
  severity      String   // low, medium, high, critical
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ============================================
// MODULO PLAYER INTELLIGENCE (8 tabelle)
// ============================================

model PlayerProfile {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String?
  vipLevel      String   @default("bronze") // bronze, silver, gold, platinum, diamond
  totalDeposits Float    @default(0)
  totalWagers   Float    @default(0)
  totalWins     Float    @default(0)
  lifetimeValue Float    @default(0)
  churnRisk     Float    @default(0) // 0-1 score
  status        String   @default("active") // active, inactive, suspended, self_excluded
  country       String?
  registeredAt  DateTime @default(now())
  lastActivityAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deposits      CasinoDeposit[]
  withdrawals   TotalWithdrawal[]
  notes         PlayerNote[]
  segments      PlayerSegmentAssignment[]
  timeline      PlayerTimeline[]
  bonusHistory  PlayerBonusHistory[]
  wallets       Wallet[]
  paymentMethods PaymentMethod[]
  depositRequests DepositRequest[]
  withdrawalRequests WithdrawalRequest[]
  sessions      PlayerSession[]
}

model GameControl {
  id            String   @id @default(cuid())
  playerId      String
  gameId        String
  gameName      String
  sessions      Int      @default(0)
  totalWagered  Float    @default(0)
  totalWon      Float    @default(0)
  avgSessionDuration Float @default(0) // minutes
  lastPlayedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ResponsibleLimit {
  id            String   @id @default(cuid())
  playerId      String
  dailyDepositLimit Float?
  weeklyDepositLimit Float?
  monthlyDepositLimit Float?
  sessionTimeLimit Float?  // minutes
  lossLimit     Float?
  selfExclusionEnd DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlayerNote {
  id            String   @id @default(cuid())
  playerId      String
  authorRole    String   // finance, controller, support
  content       String
  isInternal    Boolean  @default(true)
  createdAt     DateTime @default(now())
  player        PlayerProfile @relation(fields: [playerId], references: [id])
}

model PlayerSegmentAssignment {
  id            String   @id @default(cuid())
  playerId      String
  segmentId     String
  assignedAt    DateTime @default(now())
  player        PlayerProfile @relation(fields: [playerId], references: [id])
  segment       Segment @relation(fields: [segmentId], references: [id])
}

model PlayerTimeline {
  id            String   @id @default(cuid())
  playerId      String
  eventType     String   // deposit, withdrawal, game_session, bonus_claim, limit_change
  description   String
  metadata      String?  // JSON
  createdAt     DateTime @default(now())
  player        PlayerProfile @relation(fields: [playerId], references: [id])
}

model PlayerHeatmap {
  id            String   @id @default(cuid())
  playerId      String
  gameId        String
  dayOfWeek     Int      // 0-6
  hourOfDay     Int      // 0-23
  intensity     Float    // normalized 0-1
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlayerBonusHistory {
  id            String   @id @default(cuid())
  playerId      String
  promotionId   String?
  bonusCode     String?
  amount        Float
  wageringRequired Float
  wageringCompleted Float @default(0)
  status        String   @default("active") // active, completed, expired, forfeited
  claimedAt     DateTime @default(now())
  expiresAt     DateTime?
  player        PlayerProfile @relation(fields: [playerId], references: [id])
}

// ============================================
// MODULO MARKETING & CRM (7 tabelle)
// ============================================

model Segment {
  id            String   @id @default(cuid())
  name          String
  description   String?
  rules         String   // JSON filter rules
  playerCount   Int      @default(0)
  isDynamic     Boolean  @default(true)
  color         String   @default("#10b981")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  players       PlayerSegmentAssignment[]
  promotions    Promotion[]
}

model Promotion {
  id            String   @id @default(cuid())
  name          String
  type          String   // deposit_match, free_spins, cashback, no_deposit, loyalty
  segmentId     String?
  bonusPercent  Float?
  maxAmount     Float?
  freeSpins     Int?
  wageringMultiplier Float @default(30)
  minDeposit    Float?
  isActive      Boolean  @default(true)
  startsAt      DateTime
  endsAt        DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  segment       Segment? @relation(fields: [segmentId], references: [id])
  stats         PromotionStat[]
  bonusCodes    BonusCode[]
}

model PromotionStat {
  id            String   @id @default(cuid())
  promotionId   String
  claims        Int      @default(0)
  conversions   Int      @default(0)
  totalBonusGiven Float  @default(0)
  totalWagered  Float    @default(0)
  revenue       Float    @default(0)
  periodDate    DateTime @default(now())
  promotion     Promotion @relation(fields: [promotionId], references: [id])
}

model BonusCode {
  id            String   @id @default(cuid())
  promotionId   String
  code          String   @unique
  maxUses       Int?
  currentUses   Int      @default(0)
  isActive      Boolean  @default(true)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  promotion     Promotion @relation(fields: [promotionId], references: [id])
}

model WageringRequirement {
  id            String   @id @default(cuid())
  playerBonusId String
  totalRequired Float
  totalCompleted Float @default(0)
  remaining     Float
  gamesContrib  String?  // JSON game contribution rates
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ConversionTracking {
  id            String   @id @default(cuid())
  promotionId   String?
  playerId      String
  eventType     String   // view, click, claim, convert, expire
  value         Float?
  createdAt     DateTime @default(now())
}

model CronSchedule {
  id            String   @id @default(cuid())
  name          String
  taskType      String   // bonus_code_generation, segment_refresh, report_generation
  cronExpression String
  isActive      Boolean  @default(true)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// MODULO AFFILIATI (4 tabelle)
// ============================================

model AffiliateProfile {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  website       String?
  tier          String   @default("bronze") // bronze, silver, gold, platinum
  commissionRate Float  @default(25)
  totalEarnings Float    @default(0)
  activePlayers Int      @default(0)
  status        String   @default("active") // active, suspended, terminated
  joinedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  commissions   CommissionLog[]
  performance   AffiliatePerformance[]
}

model AffiliatePerformance {
  id            String   @id @default(cuid())
  affiliateId   String
  period        String   // month/week
  clicks        Int      @default(0)
  signups       Int      @default(0)
  ftd           Int      @default(0) // first time deposits
  revenue       Float    @default(0)
  createdAt     DateTime @default(now())
  affiliate     AffiliateProfile @relation(fields: [affiliateId], references: [id])
}

model AffiliateCommission {
  id            String   @id @default(cuid())
  affiliateId   String
  amount        Float
  source        String   // revenue_share, cpa, hybrid
  periodMonth   String
  isPaid        Boolean  @default(false)
  paidAt        DateTime?
  createdAt     DateTime @default(now())
}

model AffiliateTier {
  id            String   @id @default(cuid())
  name          String   // bronze, silver, gold, platinum
  minFtd        Int
  minRevenue    Float
  commissionRate Float
  bonusRate     Float    @default(0)
  createdAt     DateTime @default(now())
}

// ============================================
// MODULO LEGALE & SICUREZZA (4 tabelle)
// ============================================

model ContractSignature {
  id            String   @id @default(cuid())
  contractType  String   // operator_agreement, affiliate_terms, nda
  documentName  String
  documentUrl   String?
  docusignId    String?
  signers       String   // JSON array
  status        String   @default("pending") // pending, sent, signed, expired
  expiresAt     DateTime?
  signedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  userRole      String?
  action        String
  resource      String
  resourceId    String?
  details       String?  // JSON
  ipAddress     String?
  createdAt     DateTime @default(now())
}

model UserRole {
  id            String   @id @default(cuid())
  userId        String   @unique
  role          String   // super_admin, finance, controller, support, affiliate
  permissions   String   // JSON array
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AITutorInstance {
  id            String   @id @default(cuid())
  userId        String
  contextType   String   // financial, player, promotion, general
  contextId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// MODULO AI & ANALYTICS (2 tabelle)
// ============================================

model AILog {
  id            String   @id @default(cuid())
  model         String
  prompt        String
  response      String
  tokensUsed    Int?
  latencyMs     Int?
  tutorInstanceId String?
  createdAt     DateTime @default(now())
}

model AIModelMetric {
  id            String   @id @default(cuid())
  modelName     String
  version       String
  accuracy      Float?
  avgLatencyMs Float?
  totalRequests Int      @default(0)
  successRate   Float?
  periodDate    DateTime @default(now())
  createdAt     DateTime @default(now())
}

// ============================================
// MODULO WALLET & PAYMENTS (7 tabelle)
// ============================================

model Wallet {
  id            String   @id @default(cuid())
  playerId      String
  currency      String   // USD, EUR, GBP, BTC, ETH, USDT, USDC, LTC, BNB, SOL
  balance       Float    @default(0)
  availableBalance Float @default(0)
  lockedBalance Float    @default(0) // bonus-locked, wagering-locked
  bonusBalance  Float    @default(0) // bonus funds separate
  isPrimary     Boolean  @default(false)
  status        String   @default("active") // active, frozen, closed
  lastDepositAt DateTime?
  lastWithdrawAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  transactions  WalletTransaction[]
  player        PlayerProfile @relation(fields: [playerId], references: [id])
}

model WalletTransaction {
  id            String   @id @default(cuid())
  walletId      String
  type          String   // deposit, withdrawal, bet, win, bonus, cashback, transfer, fee, exchange
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  currency      String
  status        String   @default("completed") // pending, completed, failed, cancelled, reversed
  reference     String?  // external tx id
  gameId        String?
  gameName      String?
  promotionId   String?
  metadata      String?  // JSON
  createdAt     DateTime @default(now())
  wallet        Wallet @relation(fields: [walletId], references: [id])
}

model PaymentMethod {
  id            String   @id @default(cuid())
  playerId      String
  type          String   // visa, mastercard, bank_transfer, crypto_wallet, e_wallet, prepaid
  provider      String   // stripe, coinbase, moonpay, netseller, skrill, paypal
  label         String   // "Visa ****4242", "BTC Wallet"
  identifier    String?  // last 4 digits or wallet address (masked)
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  currency      String   @default("USD")
  metadata      String?  // JSON (encrypted details)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  player        PlayerProfile @relation(fields: [playerId], references: [id])
}

model PaymentProvider {
  id            String   @id @default(cuid())
  name          String   // Stripe, Coinbase Commerce, MoonPay, etc.
  type          String   // fiat, crypto, hybrid
  isActive      Boolean  @default(true)
  minDeposit    Float    @default(10)
  maxDeposit    Float    @default(50000)
  minWithdrawal Float    @default(20)
  maxWithdrawal Float    @default(100000)
  feePercent    Float    @default(0)
  feeFixed      Float    @default(0)
  processingTime String  @default("instant") // instant, 1-3_days, 3-5_days
  supportedCurrencies String // JSON array
  logo          String?  // URL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DepositRequest {
  id            String   @id @default(cuid())
  playerId      String
  walletId      String
  amount        Float
  currency      String
  method        String   // card, crypto, bank_transfer, e_wallet
  provider      String
  status        String   @default("pending") // pending, processing, confirmed, failed, expired
  txHash        String?  // blockchain hash
  feeAmount     Float    @default(0)
  netAmount     Float    // amount - fee
  paymentMethodId String?
  metadata      String?  // JSON
  confirmedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  player        PlayerProfile @relation(fields: [playerId], references: [id])
}

model WithdrawalRequest {
  id            String   @id @default(cuid())
  playerId      String
  walletId      String
  amount        Float
  currency      String
  method        String
  provider      String
  status        String   @default("pending") // pending, under_review, approved, processing, completed, rejected, cancelled
  approvedBy    String?
  approvedAt    DateTime?
  txHash        String?
  feeAmount     Float    @default(0)
  netAmount     Float
  paymentMethodId String?
  rejectionReason String?
  metadata      String?
  processedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  player        PlayerProfile @relation(fields: [playerId], references: [id])
}

model CurrencyRate {
  id            String   @id @default(cuid())
  fromCurrency  String
  toCurrency    String
  rate          Float
  source        String   @default("api") // api, manual
  updatedAt     DateTime @updatedAt
}

// ============================================
// MODULO LIVE TRACKING & GEO (4 tabelle)
// ============================================

model PlayerSession {
  id            String   @id @default(cuid())
  playerId      String
  gameId        String
  gameName      String
  ipAddress     String?
  country       String?
  city          String?
  latitude      Float?
  longitude     Float?
  deviceType    String?  // desktop, mobile, tablet
  browser       String?
  os            String?
  entryPoint    String?  // homepage, direct, affiliate, promotion
  wagerAmount   Float    @default(0)
  winAmount     Float    @default(0)
  spinsPlayed   Int      @default(0)
  startedAt     DateTime @default(now())
  lastActivityAt DateTime @default(now())
  endedAt       DateTime?
  status        String   @default("active") // active, idle, ended
  player        PlayerProfile @relation(fields: [playerId], references: [id])
}

model GeoLocation {
  id            String   @id @default(cuid())
  playerId      String
  country       String
  countryCode   String   // ISO 2-letter
  city          String?
  region        String?
  latitude      Float
  longitude     Float
  timezone      String?
  isp           String?
  isVpn         Boolean  @default(false)
  isProxy       Boolean  @default(false)
  isTor         Boolean  @default(false)
  detectedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LiveEvent {
  id            String   @id @default(cuid())
  eventType     String   // player_login, game_start, big_win, jackpot_win, deposit, withdrawal, bonus_claim, level_up, tournament_join, chat_message
  playerId      String?
  playerName    String?
  gameId        String?
  gameName      String?
  amount        Float?
  currency      String?
  country       String?
  countryCode   String?
  city          String?
  latitude      Float?
  longitude     Float?
  metadata      String?  // JSON
  createdAt     DateTime @default(now())
}

model ServerNode {
  id            String   @id @default(cuid())
  name          String   // EU-West, US-East, Asia-Pacific
  region        String
  countryCode   String
  latitude      Float
  longitude     Float
  status        String   @default("online") // online, degraded, offline, maintenance
  activePlayers Int      @default(0)
  maxPlayers    Int      @default(10000)
  cpuLoad       Float    @default(0)
  memoryLoad    Float    @default(0)
  latencyMs     Float    @default(0)
  uptime        Float    @default(99.9)
  lastHeartbeat DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// MODULO API & INTEGRATION (6 tabelle)
// ============================================

model ApiToken {
  id            String   @id @default(cuid())
  name          String   // "Production API", "Staging", "Partner X"
  token         String   @unique // hashed token
  tokenPrefix   String   // first 8 chars for display (tols_xxxx...)
  ownerId       String   // user or integration ID
  scopes        String   // JSON array: ["players:read", "wallets:write", "financial:read", ...]
  rateLimit     Int      @default(1000) // requests per minute
  isActive      Boolean  @default(true)
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  usageLogs     ApiUsageLog[]
  webhooks      WebhookEndpoint[]
}

model WebhookEndpoint {
  id            String   @id @default(cuid())
  apiTokenId    String
  name          String   // "Notify on Deposit", "Player Events"
  url           String   // https://partner.com/webhooks/tols
  events        String   // JSON array: ["deposit.confirmed", "withdrawal.completed", "player.login", ...]
  secret        String   // HMAC secret for signature verification
  isActive      Boolean  @default(true)
  retryCount    Int      @default(3)
  timeoutMs     Int      @default(5000)
  lastTriggerAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  apiToken      ApiToken @relation(fields: [apiTokenId], references: [id])
  deliveries    WebhookDelivery[]
}

model WebhookDelivery {
  id            String   @id @default(cuid())
  webhookId     String
  eventId       String   // event type that triggered this
  payload       String   // JSON payload sent
  statusCode    Int?     // HTTP response status
  response      String?  // response body (truncated)
  duration      Int?     // ms
  success       Boolean
  attempt       Int      @default(1)
  nextRetryAt   DateTime?
  createdAt     DateTime @default(now())
  webhook       WebhookEndpoint @relation(fields: [webhookId], references: [id])
}

model Integration {
  id            String   @id @default(cuid())
  name          String   // "BetMGM", "PokerStars", "Custom Platform"
  type          String   // casino_poker, casino_slots, sports_betting, lottery, custom
  status        String   @default("pending") // pending, connected, syncing, error, disconnected
  apiTokenId    String?
  config        String   // JSON: { baseUrl, authType, apiKey, syncInterval, ... }
  syncStats     String?  // JSON: { lastSync, recordsSynced, errors, ... }
  logo          String?  // URL
  lastSyncAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model McpEndpoint {
  id            String   @id @default(cuid())
  name          String   // "TOLS Player Intelligence", "TOLS Financial API"
  description   String
  version       String   @default("1.0.0")
  baseUrl       String   // /api/mcp/players, /api/mcp/financial
  tools         String   // JSON array of MCP tool definitions
  resources     String   // JSON array of MCP resource definitions
  isActive      Boolean  @default(true)
  requiresAuth  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ApiUsageLog {
  id            String   @id @default(cuid())
  apiTokenId    String
  endpoint      String   // /api/players, /api/wallets
  method        String   // GET, POST, PUT, DELETE
  statusCode    Int
  durationMs    Int
  ipAddress     String?
  userAgent     String?
  error         String?
  createdAt     DateTime @default(now())
  apiToken      ApiToken @relation(fields: [apiTokenId], references: [id])
}

// ============================================
// MODULO NOTIFICATIONS (4 tabelle)
// ============================================

model Notification {
  id            String   @id @default(cuid())
  userId        String?  // null = broadcast to all
  type          String   // info, warning, success, error, critical
  category      String   // financial, player, system, webhook, integration, compliance
  title         String
  message       String
  metadata      String?  // JSON: { link, actionUrl, entityType, entityId, ... }
  isRead        Boolean  @default(false)
  readAt        DateTime?
  channel       String   @default("in_app") // in_app, email, sms, webhook, push
  priority      String   @default("normal") // low, normal, high, urgent
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
}

model NotificationPreference {
  id            String   @id @default(cuid())
  userId        String
  category      String   // financial, player, system, webhook, integration, compliance
  channel       String   // in_app, email, sms, webhook, push
  isEnabled     Boolean  @default(true)
  minPriority   String   @default("normal") // only notify for this priority and above
  quietHoursStart String? // "22:00"
  quietHoursEnd   String? // "08:00"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NotificationTemplate {
  id            String   @id @default(cuid())
  name          String   // "deposit_confirmed", "withdrawal_pending", "variance_alert"
  category      String
  titleTemplate String   // "Deposit of {{amount}} {{currency}} Confirmed"
  bodyTemplate  String   // "Player {{playerName}} deposit of {{amount}} ..."
  channel       String   @default("in_app")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NotificationChannel {
  id            String   @id @default(cuid())
  userId        String
  type          String   // email, sms, webhook, slack, discord, telegram
  config        String   // JSON: { email, phone, webhookUrl, slackChannel, ... }
  isVerified    Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
